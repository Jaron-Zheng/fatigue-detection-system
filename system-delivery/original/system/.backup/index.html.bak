<!DOCTYPE html>
<html lang="zh-CN" data-theme="auto">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="description" content="基于面部多特征融合的Web端驾驶员疲劳检测系统：浏览器端实时人脸关键点分析，融合PERCLOS、哈欠、点头、头部姿态等多维特征进行疲劳分级预警。">
<title>驾驶员疲劳检测系统 · 基于面部多特征融合</title>
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="css/tokens.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/layout.css">
</head>
<body>

<a class="skip-link" href="#main">跳到主内容</a>

<!-- ============ SVG 图标库 ============ -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-logo" viewBox="0 0 24 24">
      <path fill="currentColor" d="M12 2.6c-5.19 0-9.4 3.62-9.4 8.09 0 2.3 1.12 4.37 2.92 5.85v3.02c0 .7.77 1.12 1.36.75l2.6-1.63c.81.16 1.65.25 2.52.25 5.19 0 9.4-3.62 9.4-8.24S17.19 2.6 12 2.6Z" opacity=".18"/>
      <circle cx="8.4" cy="10.4" r="1.5" fill="currentColor"/>
      <circle cx="15.6" cy="10.4" r="1.5" fill="currentColor"/>
      <path d="M8.2 14.6c1.05.9 2.35 1.35 3.8 1.35s2.75-.45 3.8-1.35" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
      <path d="M12 2.6c-5.19 0-9.4 3.62-9.4 8.09 0 2.3 1.12 4.37 2.92 5.85v3.02c0 .7.77 1.12 1.36.75l2.6-1.63c.81.16 1.65.25 2.52.25 5.19 0 9.4-3.62 9.4-8.24S17.19 2.6 12 2.6Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-eye" viewBox="0 0 24 24">
      <path d="M2 12s3.6-6.4 10-6.4S22 12 22 12s-3.6 6.4-10 6.4S2 12 2 12Z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>
      <circle cx="12" cy="12" r="2.7" stroke="currentColor" stroke-width="1.7" fill="none"/>
    </symbol>
    <symbol id="i-brain" viewBox="0 0 24 24">
      <path d="M9.5 4a3 3 0 0 0-3 3 2.6 2.6 0 0 0-2 2.5c0 .8.3 1.5.9 2A2.7 2.7 0 0 0 4.6 14c0 1.3.9 2.4 2.1 2.8A2.7 2.7 0 0 0 9.4 20c1 0 1.9-.5 2.4-1.3V4.9A2.9 2.9 0 0 0 9.5 4Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
      <path d="M14.5 4a3 3 0 0 1 3 3 2.6 2.6 0 0 1 2 2.5c0 .8-.3 1.5-.9 2A2.7 2.7 0 0 1 19.4 14c0 1.3-.9 2.4-2.1 2.8A2.7 2.7 0 0 1 14.6 20c-1 0-1.9-.5-2.4-1.3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-shield" viewBox="0 0 24 24">
      <path d="M12 2.8 4.6 5.6v5.9c0 4.3 3 8.2 7.4 9.7 4.4-1.5 7.4-5.4 7.4-9.7V5.6L12 2.8Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>
      <path d="m8.8 12 2.3 2.3 4.1-4.4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-bolt" viewBox="0 0 24 24">
      <path d="M13.2 2.5 5.4 13.4h5l-1.6 8.1 8-11.2h-5l1.4-7.8Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-chart" viewBox="0 0 24 24">
      <path d="M4 19V6M4 19h16" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>
      <path d="m7 15 3.4-4.2 3 2.5L18 7.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-gear" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7" fill="none"/>
      <path d="M12 3.2v2M12 18.8v2M4.8 12h2M17.2 12h2M6.9 6.9l1.4 1.4M15.7 15.7l1.4 1.4M17.1 6.9l-1.4 1.4M8.3 15.7l-1.4 1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </symbol>
    <symbol id="i-sun" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" fill="none"/>
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </symbol>
    <symbol id="i-moon" viewBox="0 0 24 24">
      <path d="M20 14.4A8.5 8.5 0 0 1 9.6 4a8.6 8.6 0 1 0 10.4 10.4Z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-sound" viewBox="0 0 24 24">
      <path d="M11 4.8 6.6 8.6H3.4v6.8h3.2L11 19.2V4.8Z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>
      <path d="M15.2 9.2a4 4 0 0 1 0 5.6M18 6.4a8 8 0 0 1 0 11.2" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>
    </symbol>
    <symbol id="i-mute" viewBox="0 0 24 24">
      <path d="M11 4.8 6.6 8.6H3.4v6.8h3.2L11 19.2V4.8Z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>
      <path d="m15.4 9.6 4.4 4.8M19.8 9.6l-4.4 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </symbol>
    <symbol id="i-mesh" viewBox="0 0 24 24">
      <circle cx="6" cy="6" r="1.5" fill="currentColor"/><circle cx="12" cy="4.6" r="1.5" fill="currentColor"/>
      <circle cx="18" cy="6" r="1.5" fill="currentColor"/><circle cx="4.8" cy="12" r="1.5" fill="currentColor"/>
      <circle cx="12" cy="11.4" r="1.5" fill="currentColor"/><circle cx="19.2" cy="12" r="1.5" fill="currentColor"/>
      <circle cx="7" cy="18" r="1.5" fill="currentColor"/><circle cx="12" cy="19.4" r="1.5" fill="currentColor"/>
      <circle cx="17" cy="18" r="1.5" fill="currentColor"/>
      <path d="M6 6 12 4.6 18 6l1.2 6-2.2 6L12 19.4 7 18l-2.2-6L6 6Z" stroke="currentColor" stroke-width="1.1" fill="none" opacity=".5"/>
    </symbol>
    <symbol id="i-mirror" viewBox="0 0 24 24">
      <path d="M12 3v18" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 3"/>
      <path d="M9.4 6.4 4.2 12l5.2 5.6V6.4ZM14.6 6.4 19.8 12l-5.2 5.6V6.4Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-gauge" viewBox="0 0 24 24">
      <path d="M4 17a8.6 8.6 0 1 1 16 0" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>
      <path d="m12 17 4-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <circle cx="12" cy="17" r="1.6" fill="currentColor"/>
    </symbol>
    <symbol id="i-pause" viewBox="0 0 24 24">
      <rect x="7" y="5" width="3.4" height="14" rx="1.2" fill="currentColor"/>
      <rect x="13.6" y="5" width="3.4" height="14" rx="1.2" fill="currentColor"/>
    </symbol>
    <symbol id="i-play" viewBox="0 0 24 24">
      <path d="M8 5.4v13.2l11-6.6L8 5.4Z" fill="currentColor"/>
    </symbol>
    <symbol id="i-stop" viewBox="0 0 24 24">
      <rect x="6" y="6" width="12" height="12" rx="2.4" fill="currentColor"/>
    </symbol>
    <symbol id="i-target" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <circle cx="12" cy="12" r="1.2" fill="currentColor"/>
    </symbol>
    <symbol id="i-warn" viewBox="0 0 24 24">
      <path d="M12 3.4 2.6 20h18.8L12 3.4Z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>
      <path d="M12 9.4v4.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      <circle cx="12" cy="16.8" r="1.1" fill="currentColor"/>
    </symbol>
    <symbol id="i-download" viewBox="0 0 24 24">
      <path d="M12 4v10.4M8.2 11l3.8 3.8L15.8 11" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4.6 17.4v1.2a1.8 1.8 0 0 0 1.8 1.8h11.2a1.8 1.8 0 0 0 1.8-1.8v-1.2" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>
    </symbol>
    <symbol id="i-close" viewBox="0 0 24 24">
      <path d="m6.4 6.4 11.2 11.2M17.6 6.4 6.4 17.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </symbol>
    <symbol id="i-expand" viewBox="0 0 24 24">
      <path d="M9.2 4.4H4.4v4.8M14.8 4.4h4.8v4.8M19.6 14.8v4.8h-4.8M4.4 14.8v4.8h4.8" stroke="currentColor" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-lock" viewBox="0 0 24 24">
      <rect x="5" y="10.4" width="14" height="9.6" rx="2.2" stroke="currentColor" stroke-width="1.7" fill="none"/>
      <path d="M8.4 10.4V7.8a3.6 3.6 0 0 1 7.2 0v2.6" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>
    </symbol>
  </defs>
</svg>

<!-- ============ 顶部导航 ============ -->
<header class="nav">
  <div class="nav-inner">
    <a class="nav-brand" href="#" id="brandLink">
      <svg class="nav-logo" aria-hidden="true"><use href="#i-logo"></use></svg>
      <span class="nav-brand-text">
        驾驶员疲劳检测系统
        <small>基于面部多特征融合 · 浏览器端实时推理</small>
      </span>
    </a>
    <div class="nav-spacer"></div>
    <div class="nav-status" id="navStatus" role="status" aria-live="polite">
      <span class="dot" style="background:var(--text-quaternary)" id="navDot"></span>
      <span id="navStatusText">未启动</span>
    </div>
    <div class="nav-actions">
      <!-- 专业模式：默认关闭，普通用户看到的是极简界面；
           打开后展开全部技术指标与实验工具（写论文、答辩演示时用）。 -->
      <button class="pill pill-sm" id="btnProMode" type="button" aria-pressed="false"
              title="显示全部技术指标与实验分析工具">专业模式</button>
      <button class="btn-icon" id="btnMute" type="button" title="报警声音开关" aria-label="报警声音开关">
        <svg aria-hidden="true"><use href="#i-sound" id="muteIcon"></use></svg>
      </button>
      <button class="btn-icon" id="btnTheme" type="button" title="切换深浅色" aria-label="切换深浅色">
        <svg aria-hidden="true"><use href="#i-moon" id="themeIcon"></use></svg>
      </button>
      <button class="btn-icon" id="btnSettings" type="button" title="设置" aria-label="设置">
        <svg aria-hidden="true"><use href="#i-gear"></use></svg>
      </button>
    </div>
  </div>
</header>

<main id="main">

<!-- ============================================================ -->
<!-- 视图一：首屏                                                  -->
<!-- ============================================================ -->
<section class="view active" id="viewHome">
  <div class="page">
    <div class="hero">
      <div class="hero-inner">
        <div class="hero-eyebrow">
          <svg width="14" height="14" aria-hidden="true"><use href="#i-lock"></use></svg>
          全部计算在本机浏览器完成，视频不上传
        </div>
        <h1 class="t-balance">
          让每一次疲劳征兆<br><span class="grad">都被提前看见</span>
        </h1>
        <!-- 注意：中文段落不要在源码里换行。HTML 会把换行折叠成一个空格，
             而中文标点本身已含间距，叠加后会出现明显的空洞。 -->
        <p class="hero-lead">用摄像头看着你的眼睛、嘴巴和头部动作，实时判断你有多困，在真正危险之前就出声提醒。打开网页就能用，不装软件、不用联网，画面也不会离开这台电脑。</p>
        <p class="t-caption pro-only" style="max-width:640px;margin:-8px auto 0">技术实现：融合 PERCLOS、眨眼动力学、哈欠、点头与头部姿态五类面部特征，经隶属函数归一化后模糊加权，实时输出 0–100 疲劳指数与四级预警。</p>
        <div class="hero-cta">
          <button class="btn btn-primary btn-lg" id="btnStart" type="button">
            <svg width="18" height="18" aria-hidden="true"><use href="#i-play"></use></svg>
            开始检测
          </button>
        </div>

        <div class="boot" id="bootBox" hidden>
          <div class="boot-row">
            <span class="spinner" id="bootSpinner"></span>
            <span id="bootMsg">正在准备…</span>
          </div>
          <div class="progress"><div class="progress-bar" id="bootBar" style="width:0%"></div></div>
        </div>

        <div class="hero-features">
          <div class="feat">
            <div class="feat-icon"><svg aria-hidden="true"><use href="#i-eye"></use></svg></div>
            <h3>看清每一次眨眼</h3>
            <p>在脸上定位 478 个点，眼睛睁多大、嘴巴张多开、头往哪偏，逐帧都算得清。</p>
          </div>
          <div class="feat">
            <div class="feat-icon"><svg aria-hidden="true"><use href="#i-brain"></use></svg></div>
            <h3>多个信号一起判断</h3>
            <p>只看一项容易误判。眨眼、哈欠、点头、走神等七项一起看，结论更稳。</p>
          </div>
          <div class="feat">
            <div class="feat-icon"><svg aria-hidden="true"><use href="#i-target"></use></svg></div>
            <h3>先认识你，再判断你</h3>
            <p>开始前花几秒记住你睁眼时的样子。眼睛天生大小不同，标准也就该不同。</p>
          </div>
          <div class="feat">
            <div class="feat-icon"><svg aria-hidden="true"><use href="#i-shield"></use></svg></div>
            <h3>画面不出这台电脑</h3>
            <p>计算全在浏览器里完成，视频不上传、不存盘，关掉网页就什么都不剩。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 视图二：检测工作台                                            -->
<!-- ============================================================ -->
<section class="view" id="viewWork">
  <div class="page">
    <div class="workspace">

      <!-- ---------- 左侧：视频 + 图表 ---------- -->
      <div class="ws-main">

        <div class="stage" id="stage">
          <video id="video" playsinline muted autoplay class="mirrored"></video>
          <canvas id="overlay"></canvas>

          <div class="hud" id="hud">
            <div class="hud-row"><span>眼睛闭合</span><b class="tnum" id="hudClosure">--</b></div>
            <div class="hud-row pro-only"><span>眼睛开合度</span><b class="tnum" id="hudEar">--</b></div>
            <div class="hud-row pro-only"><span>嘴巴张开度</span><b class="tnum" id="hudMar">--</b></div>
            <div class="hud-row pro-only"><span>抬头低头</span><b class="tnum" id="hudPitch">--</b></div>
            <div class="hud-row pro-only"><span>左右转头</span><b class="tnum" id="hudYaw">--</b></div>
            <div class="hud-row pro-only"><span>头部倾斜</span><b class="tnum" id="hudRoll">--</b></div>
          </div>

          <div class="stage-badges">
            <div class="stage-pill" id="stagePill">
              <span class="dot dot-pulse" id="stageDot"></span>
              <span id="stageLevel">清醒</span>
            </div>
            <div class="stage-pill pro-only">
              <span class="tnum" id="stageFps">-- FPS</span>
            </div>
            <div class="stage-pill" id="stageFaceState">
              <span id="stageFaceText">等待人脸</span>
            </div>
            <div class="stage-pill" id="stageQuality" hidden>
              <span id="stageQualityText">数据质量</span>
            </div>
          </div>

          <!-- 遮罩：标定 / 错误 / 暂停 -->
          <div class="stage-overlay" id="stageOverlay" hidden>
            <div>
              <div class="calib-ring" id="calibRing" hidden>
                <svg viewBox="0 0 120 120">
                  <circle class="track" cx="60" cy="60" r="52"></circle>
                  <circle class="bar" cx="60" cy="60" r="52" id="calibBar"
                          stroke-dasharray="326.7" stroke-dashoffset="326.7"></circle>
                </svg>
                <div class="num tnum" id="calibNum">8</div>
              </div>
              <h3 id="overlayTitle">正在认识你的眼睛</h3>
              <p id="overlayText">请正视摄像头，自然睁眼、放松表情。</p>
              <div id="overlayActions" style="margin-top:20px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap"></div>
            </div>
          </div>
        </div>

        <!-- ===== 控制条：从视频内部移出，改用文字按钮 =====
             移出的理由：叠在画面上的图标按钮会遮挡面部区域，
             而面部正是本系统最需要观察的地方；图标也需要猜测含义。
             文字按钮不仅一目了然，还便于口头指代（"点重新标定"而不是"点那个靶心图标"）。 -->
        <div class="controls" role="toolbar" aria-label="检测控制">
          <div class="controls-group">
            <span class="controls-label" aria-hidden="true">画面</span>
            <button class="pill is-on" id="btnMesh" type="button" aria-pressed="true">
              <svg aria-hidden="true"><use href="#i-mesh"></use></svg>识别点
            </button>
            <button class="pill is-on" id="btnMirror" type="button" aria-pressed="true">
              <svg aria-hidden="true"><use href="#i-mirror"></use></svg>镜像
            </button>
            <button class="pill is-on" id="btnHud" type="button" aria-pressed="true">
              <svg aria-hidden="true"><use href="#i-gauge"></use></svg>实时数值
            </button>
          </div>

          <span class="controls-sep" aria-hidden="true"></span>

          <div class="controls-group">
            <span class="controls-label" aria-hidden="true">检测</span>
            <button class="pill" id="btnRecalib" type="button">
              <svg aria-hidden="true"><use href="#i-target"></use></svg>重新校准
            </button>
            <button class="pill pill-primary" id="btnPause" type="button">
              <svg aria-hidden="true"><use href="#i-pause" id="pauseIcon"></use></svg><span id="pauseLabel">暂停</span>
            </button>
            <button class="pill pill-danger" id="btnStop" type="button">
              <svg aria-hidden="true"><use href="#i-stop"></use></svg>结束并生成报告
            </button>
          </div>

          <span class="controls-spacer"></span>

          <div class="controls-group">
            <button class="pill pill-sm" id="btnFullscreen" type="button">
              <svg aria-hidden="true"><use href="#i-expand"></use></svg>全屏
            </button>
          </div>
        </div>

        <!-- 疲劳趋势图 -->
        <div class="card ord-chart1">
          <div class="card-head">
            <div class="card-title">
              <svg width="18" height="18" aria-hidden="true"><use href="#i-chart"></use></svg>
              疲劳指数趋势
            </div>
            <div class="legend">
              <span><i style="background:var(--chart-score)"></i>疲劳指数</span>
              <span class="pro-only"><i style="background:var(--text-quaternary)"></i>平滑前原始值</span>
            </div>
          </div>
          <div class="chart-box"><canvas id="chartScore" aria-label="疲劳指数随时间变化曲线"></canvas></div>
        </div>

        <!-- 眼/嘴波形图（专业模式） -->
        <div class="card ord-chart2 pro-only">
          <div class="card-head">
            <div class="card-title">
              <svg width="18" height="18" aria-hidden="true"><use href="#i-eye"></use></svg>
              眼睑与嘴部特征波形
            </div>
            <div class="legend">
              <span><i style="background:var(--chart-ear)"></i>EAR 眼纵横比</span>
              <span><i style="background:var(--chart-mar)"></i>MAR 嘴纵横比</span>
              <span><i style="background:var(--danger)"></i>闭眼阈值</span>
            </div>
          </div>
          <div class="chart-box"><canvas id="chartEye" aria-label="眼纵横比与嘴纵横比波形"></canvas></div>
        </div>

        <!-- 融合贡献度（专业模式） -->
        <div class="card ord-fusion pro-only">
          <div class="card-head">
            <div class="card-title">
              <svg width="18" height="18" aria-hidden="true"><use href="#i-brain"></use></svg>
              疲劳分数是怎么算出来的
            </div>
            <span class="badge" id="fusionSum">合计 0.0 分</span>
          </div>
          <p class="t-caption" style="margin-bottom:12px">
            每项指标经隶属函数归一化到 0–1，再乘以权重后累加。条形长度即该指标对当前疲劳指数的实际贡献分。
          </p>
          <div id="contribList"></div>
        </div>
      </div>

      <!-- ---------- 右侧：总览 + 指标 + 事件 ---------- -->
      <div class="ws-side">

        <div class="card score-card">
          <div class="gauge">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle class="track" cx="60" cy="60" r="50"></circle>
              <circle class="bar" cx="60" cy="60" r="50" id="gaugeBar"
                      stroke-dasharray="314.16" stroke-dashoffset="314.16"></circle>
            </svg>
            <div class="gauge-center">
              <div class="gauge-num tnum" id="gaugeNum">0</div>
              <div class="gauge-cap">疲劳指数</div>
            </div>
          </div>
          <div class="score-info">
            <div class="level-chip" id="levelChip" data-level="awake">
              <span class="dot"></span><span id="levelText">清醒</span>
            </div>
            <div class="score-reason" id="scoreReason">等待检测数据…</div>
            <div class="score-meta">
              <div><div class="k">检测时长</div><div class="v tnum" id="metaDuration">00:00</div></div>
              <div><div class="k">峰值</div><div class="v tnum" id="metaPeak">0</div></div>
              <div><div class="k">均值</div><div class="v tnum" id="metaAvg">0</div></div>
            </div>
          </div>
        </div>

        <div class="metric-grid">
          <div class="metric" id="mPerclos">
            <div class="metric-label">闭眼时间占比<span class="hint" title="最近 30 秒里眼睛处于闭合状态的时间比例。这是判断疲劳最可靠的指标：越高说明越困。专业名称为 PERCLOS">?</span></div>
            <div class="metric-value"><span class="tnum" id="vPerclos">0.0</span><span class="metric-unit">%</span></div>
            <div class="metric-sub" id="sPerclos">最近 30 秒</div>
            <div class="metric-spark"><i id="kPerclos" style="width:0%"></i></div>
          </div>

          <div class="metric" id="mClosure">
            <div class="metric-label">当前闭眼时长</div>
            <div class="metric-value"><span class="tnum" id="vClosure">0.00</span><span class="metric-unit">秒</span></div>
            <div class="metric-sub" id="sClosure">睁眼</div>
            <div class="metric-spark"><i id="kClosure" style="width:0%"></i></div>
          </div>

          <div class="metric" id="mYawn">
            <div class="metric-label">打哈欠</div>
            <div class="metric-value"><span class="tnum" id="vYawn">0</span><span class="metric-unit">次</span></div>
            <div class="metric-sub" id="sYawn">0.0 次/分</div>
            <div class="metric-spark"><i id="kYawn" style="width:0%"></i></div>
          </div>

          <div class="metric" id="mMicro">
            <div class="metric-label">长时间闭眼<span class="hint" title="单次闭眼超过 0.5 秒。正常眨眼只有 0.1~0.4 秒，超过说明可能已经短暂睡着">?</span></div>
            <div class="metric-value"><span class="tnum" id="vMicro">0</span><span class="metric-unit">次</span></div>
            <div class="metric-sub" id="sMicro">超过 0.5 秒算一次</div>
            <div class="metric-spark"><i id="kMicro" style="width:0%"></i></div>
          </div>

          <div class="metric" id="mNod">
            <div class="metric-label">点头</div>
            <div class="metric-value"><span class="tnum" id="vNod">0</span><span class="metric-unit">次</span></div>
            <div class="metric-sub" id="sNod">0.0 次/分</div>
            <div class="metric-spark"><i id="kNod" style="width:0%"></i></div>
          </div>

          <div class="metric" id="mHeadDev">
            <div class="metric-label">注意力分散<span class="hint" title="头部偏离正前方的时间占比。偏离过久说明注意力不在路面上">?</span></div>
            <div class="metric-value"><span class="tnum" id="vHeadDev">0.0</span><span class="metric-unit">%</span></div>
            <div class="metric-sub" id="sHeadDev">头部偏离前方</div>
            <div class="metric-spark"><i id="kHeadDev" style="width:0%"></i></div>
          </div>

          <div class="metric pro-only" id="mBlink">
            <div class="metric-label">眨眼频率<span class="hint" title="正常成人自发眨眼约 12–22 次/分；疲劳早期因代偿性唤醒而升高，进入深度嗜睡后转为降低且单次时长明显变长">?</span></div>
            <div class="metric-value"><span class="tnum" id="vBlink">0.0</span><span class="metric-unit">次/分</span></div>
            <div class="metric-sub" id="sBlink">正常区间 12–22</div>
            <div class="metric-spark"><i id="kBlink" style="width:0%"></i></div>
          </div>

          <div class="metric pro-only" id="mBlinkDur">
            <div class="metric-label">平均眨眼时长</div>
            <div class="metric-value"><span class="tnum" id="vBlinkDur">--</span><span class="metric-unit">ms</span></div>
            <div class="metric-sub" id="sBlinkDur">清醒约 100–200</div>
            <div class="metric-spark"><i id="kBlinkDur" style="width:0%"></i></div>
          </div>
        </div>

        <div class="card ord-timeline">
          <div class="card-head">
            <div class="card-title">
              <svg width="18" height="18" aria-hidden="true"><use href="#i-warn"></use></svg>
              检测记录
            </div>
            <div style="display:flex;gap:6px;align-items:center">
              <span class="badge" id="eventCount">0 条</span>
              <button class="btn btn-ghost btn-sm" id="btnFilterEvents" type="button">仅看异常</button>
            </div>
          </div>
          <div class="timeline" id="timeline">
            <div class="empty">暂无事件</div>
          </div>
        </div>

        <!-- 个人基准值（专业模式） -->
        <div class="card card-compact ord-calib pro-only">
          <div class="card-head" style="margin-bottom:10px">
            <div class="card-title" style="font-size:var(--fs-callout)">你的个人基准值</div>
            <span class="badge" id="calibQuality">未测量</span>
          </div>
          <table class="tbl">
            <tbody>
              <tr><th>睁眼 EAR 基线</th><td class="tnum" id="cbEarBase">--</td></tr>
              <tr><th>闭眼判定阈值</th><td class="tnum" id="cbEarClose">--</td></tr>
              <tr><th>张口判定阈值</th><td class="tnum" id="cbMarOpen">--</td></tr>
              <tr><th>姿态零点 (P/Y/R)</th><td class="tnum" id="cbPose">--</td></tr>
              <tr><th>推理耗时 / 委托</th><td class="tnum" id="cbInfer">--</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- 视图三：会话报告                                              -->
<!-- ============================================================ -->
<section class="view" id="viewReport">
  <div class="page">
    <div class="report-head">
      <div class="hero-eyebrow" style="margin-bottom:16px">
        <svg width="14" height="14" aria-hidden="true"><use href="#i-chart"></use></svg>
        检测报告
      </div>
      <h1 class="t-title report-title" id="rpTitle">本次检测汇总</h1>
      <p class="t-secondary report-subtitle" style="margin-top:10px" id="rpSubtitle">--</p>
      <!-- 关键指标摘要 pill 条：把检测时长 / 均值 / 峰值 / 覆盖率精简为行内标签，
           让标题区在视觉上更丰富，减少大片空白感 -->
      <div class="report-meta-pills" id="rpMetaPills"></div>
      <!-- 普通用户只需要两个动作：把报告存下来、或者再测一次。
           两个数据导出按钮是论文做数据分析用的，收进专业模式。 -->
      <div style="display:flex;gap:10px;justify-content:center;margin-top:24px;flex-wrap:wrap" class="no-print">
        <button class="btn btn-primary" id="btnPrint" type="button">
          <svg width="16" height="16" aria-hidden="true"><use href="#i-download"></use></svg>下载报告
        </button>
        <button class="btn btn-secondary" id="btnBackWork" type="button">再次检测</button>
        <button class="btn btn-outline pro-only" id="btnExportJson" type="button">完整数据（JSON）</button>
        <button class="btn btn-outline pro-only" id="btnExportCsv" type="button">指标表格（CSV）</button>
      </div>
    </div>

    <div class="report-grid">
      <div class="card">
        <div class="card-head"><div class="card-title">检测概要</div><span class="badge" id="rpLevelBadge">--</span></div>
        <div class="report-stat-grid">
          <div class="stat-item"><div class="n tnum" id="rpDuration">--</div><div class="l">检测时长</div></div>
          <div class="stat-item"><div class="n tnum" id="rpAvgScore">--</div><div class="l">平均疲劳指数</div></div>
          <div class="stat-item"><div class="n tnum" id="rpPeakScore">--</div><div class="l">最高疲劳指数</div></div>
          <div class="stat-item"><div class="n tnum" id="rpAvgPerclos">--</div><div class="l">平均闭眼占比</div></div>
        </div>
        <!-- 有效覆盖率提示：人脸丢失的那段时间不参与统计，必须说清楚，
             否则读者无法判断上面这些数字有多可信。 -->
        <p class="t-caption" id="rpCoverage" style="margin-top:14px" hidden></p>
      </div>

      <div class="card">
        <div class="card-head"><div class="card-title">各状态时长占比</div></div>
        <div class="dist-bar" id="rpDist"></div>
        <div class="dist-legend">
          <span><i style="background:var(--lv-awake)"></i>清醒 <b id="rpdAwake">0%</b></span>
          <span><i style="background:var(--lv-mild)"></i>轻度 <b id="rpdMild">0%</b></span>
          <span><i style="background:var(--lv-moderate)"></i>中度 <b id="rpdModerate">0%</b></span>
          <span><i style="background:var(--lv-severe)"></i>重度 <b id="rpdSevere">0%</b></span>
        </div>
        <!-- 各状态时长数字块：让分布卡有实质内容，高度能与概要卡匹配 -->
        <div class="dist-stat-row">
          <div class="dist-stat-item" style="color:var(--lv-awake)">
            <span class="n tnum" id="rpdAwakeVal">--</span>
            <span class="l">清醒</span>
          </div>
          <div class="dist-stat-item" style="color:var(--lv-mild)">
            <span class="n tnum" id="rpdMildVal">--</span>
            <span class="l">轻度</span>
          </div>
          <div class="dist-stat-item" style="color:var(--lv-moderate)">
            <span class="n tnum" id="rpdModerateVal">--</span>
            <span class="l">中度</span>
          </div>
          <div class="dist-stat-item" style="color:var(--lv-severe)">
            <span class="n tnum" id="rpdSevereVal">--</span>
            <span class="l">重度</span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><div class="card-title">检测到的行为</div></div>
        <!-- report-event-table-wrap：表格行数不定，超出卡片高度时内部滚动，
             不影响左侧两张卡片的等高布局 -->
        <div class="report-event-table-wrap">
          <table class="tbl">
            <thead><tr><th>行为</th><th style="text-align:right;white-space:nowrap">次数</th><th style="text-align:right;white-space:nowrap">每分钟</th></tr></thead>
            <tbody id="rpEventTable"></tbody>
          </table>
        </div>
      </div>

      <div class="card" style="grid-column:1/-1">
        <div class="card-head"><div class="card-title">全程疲劳指数曲线</div></div>
        <div class="chart-box" style="height:220px"><canvas id="rpChart" aria-label="全程疲劳指数曲线"></canvas></div>
      </div>

      <div class="card" style="grid-column:1/-1">
        <div class="card-head"><div class="card-title">分析与建议</div></div>
        <div class="advice-list" id="rpAdvice"></div>
      </div>

      <!-- ===== 实验分析：参数敏感性 + 消融 + 离线复现（专业模式） ===== -->
      <div class="card pro-only" style="grid-column:1/-1">
        <div class="card-head">
          <div class="card-title">
            <svg width="18" height="18" aria-hidden="true"><use href="#i-brain"></use></svg>
            参数敏感性分析
          </div>
          <span class="badge badge-info">论文实验工具</span>
        </div>
        <p class="t-caption" style="margin-bottom:14px">
          把本次会话的指标序列在多组参数下离线重算，用于回答「为什么阈值取这个值」。
          结论对参数不敏感的区间称为<b>稳定平台区</b>，默认值应落在其中——这比只引用文献范围更有说服力。
        </p>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px" class="no-print">
          <select class="select" id="selSensParam" style="max-width:240px"></select>
          <button class="btn btn-primary btn-sm" id="btnRunSens" type="button">运行敏感性分析</button>
          <button class="btn btn-secondary btn-sm" id="btnRunAblation" type="button">运行权重消融实验</button>
          <button class="btn btn-outline btn-sm" id="btnExportAnalysis" type="button">导出分析结果 CSV</button>
        </div>
        <p class="t-caption" id="sensDesc" style="margin-bottom:10px"></p>
        <div style="overflow-x:auto"><table class="tbl" id="sensTable"></table></div>
        <div id="sensConclusion" style="margin-top:14px"></div>
      </div>

      <div class="card pro-only" style="grid-column:1/-1">
        <div class="card-head">
          <div class="card-title">
            <svg width="18" height="18" aria-hidden="true"><use href="#i-chart"></use></svg>
            离线复现（导入会话 CSV）
          </div>
          <span class="badge" id="replayBadge">未导入</span>
        </div>
        <p class="t-caption" style="margin-bottom:14px">
          导入本系统导出的会话 CSV，用<b>完全相同的融合算法</b>重跑一遍并输出结论。
          用于证明结果可复现，也可在无摄像头的环境（如答辩现场）直接演示完整判定链路。
        </p>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap" class="no-print">
          <input type="file" id="fileReplay" accept=".csv,text/csv" style="display:none">
          <button class="btn btn-secondary btn-sm" id="btnPickReplay" type="button">选择会话 CSV 文件</button>
          <span class="t-caption" id="replayInfo">尚未导入文件。</span>
        </div>
        <div id="replayResult" style="margin-top:14px"></div>
      </div>

      <!-- ===== 视频离线评测：真人准确率验证（专业模式） ===== -->
      <div class="card pro-only" style="grid-column:1/-1">
        <div class="card-head">
          <div class="card-title">
            <svg width="18" height="18" aria-hidden="true"><use href="#i-target"></use></svg>
            视频离线评测（准确率验证）
          </div>
          <span class="badge badge-info" id="evalBadge">未导入视频</span>
        </div>
        <p class="t-caption" style="margin-bottom:14px">
          导入录制好的视频，按<b>固定步长</b>逐帧跑完整算法管线（与实时检测同一套代码），
          再与你的人工标注比对，输出混淆矩阵、灵敏度、特异度与响应延迟。
          固定步长保证结果与主机性能无关、可复现。视频只在本机解码，不会上传。
        </p>

        <div class="controls no-print" style="margin-bottom:16px">
          <div class="controls-group">
            <span class="controls-label" aria-hidden="true">视频</span>
            <input type="file" id="fileVideo" accept="video/*" style="display:none">
            <button class="pill pill-primary" id="btnPickVideo" type="button">
              <svg aria-hidden="true"><use href="#i-download"></use></svg>选择视频文件
            </button>
            <span class="t-caption" id="videoInfo">尚未选择。建议 MP4（H.264），时长 2~5 分钟</span>
          </div>
        </div>

        <!-- 视频预览 + 时间轴标注 -->
        <div id="evalWorkspace" hidden>
          <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,340px);gap:20px;align-items:start">
            <div>
              <div class="stage" style="aspect-ratio:16/9;background:#0a0a0b">
                <video id="evalVideo" playsinline muted controls style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;z-index:1"></video>
              </div>

              <!-- 标注时间轴 -->
              <div class="card card-compact" style="margin-top:16px">
                <div class="card-head" style="margin-bottom:10px">
                  <div class="card-title" style="font-size:var(--fs-callout)">时间区间标注</div>
                  <span class="badge" id="annotCoverage">已标注 0.0s</span>
                </div>
                <p class="t-caption" style="margin-bottom:12px">
                  播放视频，在你认为状态发生变化的时刻点「设为起点 / 终点」，然后选标签加入。
                  标签由你本人主观自评给出，等价于 KSS 嗜睡量表的简化二分。
                </p>
                <div id="annotTimeline" style="position:relative;height:36px;border-radius:8px;background:var(--fill-quaternary);overflow:hidden;margin-bottom:12px"></div>
                <div class="controls-group" style="margin-bottom:10px">
                  <button class="pill pill-sm" id="btnMarkStart" type="button">设为起点</button>
                  <span class="t-caption mono" id="markRange">-- ~ --</span>
                  <button class="pill pill-sm" id="btnMarkEnd" type="button">设为终点</button>
                </div>
                <div class="controls-group">
                  <button class="pill pill-sm" id="btnAddNormal" type="button" style="background:var(--ok-soft);color:var(--ok)">标为正常</button>
                  <button class="pill pill-sm" id="btnAddFatigue" type="button" style="background:var(--danger-soft);color:var(--danger)">标为疲劳</button>
                  <button class="pill pill-sm" id="btnAddIgnore" type="button">标为忽略</button>
                  <span class="controls-spacer"></span>
                  <button class="pill pill-sm" id="btnClearAnnot" type="button">清空标注</button>
                </div>
                <table class="tbl" id="annotTable" style="margin-top:12px"></table>
              </div>
            </div>

            <div>
              <div class="card card-compact">
                <div class="card-head" style="margin-bottom:10px">
                  <div class="card-title" style="font-size:var(--fs-callout)">评测参数</div>
                </div>
                <div id="evalSliders"></div>
                <div class="field-row" style="margin-top:14px">
                  <div>
                    <div class="field-label">疲劳判定起始等级</div>
                    <div class="field-desc">从哪一级起算作"疲劳"正类</div>
                  </div>
                  <select class="select" id="selPositiveFrom">
                    <option value="mild" selected>轻度及以上</option>
                    <option value="moderate">中度及以上</option>
                    <option value="severe">仅重度</option>
                  </select>
                </div>
                <div style="margin-top:16px;display:flex;flex-direction:column;gap:10px">
                  <button class="pill pill-solid" id="btnRunEval" type="button" style="width:100%;height:38px">开始离线评测</button>
                  <button class="pill pill-sm" id="btnCancelEval" type="button" disabled style="width:100%">取消评测</button>
                </div>
                <div class="progress" id="evalProgressWrap" hidden style="margin-top:14px">
                  <div class="progress-bar" id="evalProgress" style="width:0%"></div>
                </div>
                <p class="t-caption" id="evalStatus" style="margin-top:10px"></p>
              </div>

              <div class="card card-compact" style="margin-top:16px">
                <div class="card-head" style="margin-bottom:10px">
                  <div class="card-title" style="font-size:var(--fs-callout)">标注存档</div>
                </div>
                <p class="t-caption" style="margin-bottom:12px">
                  标注结果可导出保存，下次换参数重跑不必重新标。
                </p>
                <div class="controls-group">
                  <input type="file" id="fileAnnot" accept=".json,application/json" style="display:none">
                  <button class="pill pill-sm" id="btnExportAnnot" type="button">导出标注</button>
                  <button class="pill pill-sm" id="btnImportAnnot" type="button">导入标注</button>
                </div>
              </div>
            </div>
          </div>

          <!-- 评测结果 -->
          <div id="evalResult" style="margin-top:20px"></div>
        </div>
      </div>

      <div class="card pro-only" style="grid-column:1/-1">
        <div class="card-head"><div class="card-title">检测参数与环境</div></div>
        <table class="tbl" id="rpParams"></table>
      </div>
    </div>
  </div>
</section>

</main>

<footer class="foot">
  <p>基于面部多特征融合的 Web 端驾驶员疲劳检测系统 · 本科毕业设计</p>
  <p>关键点检测 MediaPipe Face Landmarker（本地部署） · 全部推理在浏览器内完成，不上传任何影像数据</p>
  <!-- 显卡型号与逻辑核心数只在排查性能问题、写论文实验环境时有用 -->
  <p id="footEnv" class="t-tertiary pro-only">--</p>
</footer>

<!-- ============ 报警层 ============ -->
<div class="alarm-veil" id="alarmVeil" data-level="mild" aria-hidden="true"></div>
<div class="alarm-banner" id="alarmBanner" role="alert" data-level="severe" aria-hidden="true">
  <svg class="ab-icon" aria-hidden="true"><use href="#i-warn"></use></svg>
  <span id="alarmText">检测到重度疲劳，请立即停车休息</span>
  <button type="button" id="btnDismissAlarm">知道了</button>
</div>

<!-- ============ 设置抽屉 ============ -->
<div class="sheet-backdrop" id="sheetBackdrop"></div>
<aside class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" aria-hidden="true">
  <div class="sheet-head">
    <h2 class="t-headline" id="sheetTitle">设置</h2>
    <button class="btn-icon" id="btnCloseSheet" type="button" aria-label="关闭设置"><svg aria-hidden="true"><use href="#i-close"></use></svg></button>
  </div>
  <div class="sheet-body">

    <!-- 算法参数三组：普通用户改了只会让判定变差，收进专业模式。
         做敏感性分析与消融实验时需要，所以保留而不删除。 -->
    <div class="field-group pro-only">
      <div class="group-title">融合权重（合计自动归一化）</div>
      <div id="weightSliders"></div>
    </div>

    <div class="field-group pro-only">
      <div class="group-title">判定阈值</div>
      <div id="thresholdSliders"></div>
    </div>

    <div class="field-group pro-only">
      <div class="group-title">时间窗口</div>
      <div id="windowSliders"></div>
    </div>

    <div class="field-group">
      <div class="group-title">提醒方式</div>
      <div class="field-row">
        <div><div class="field-label">声音与闪屏提醒</div><div class="field-desc">越困提醒越强烈</div></div>
        <label class="switch"><input type="checkbox" id="swAlarm" checked><span class="switch-track"></span><span class="switch-thumb"></span></label>
      </div>
      <div class="field-row">
        <div><div class="field-label">语音提示</div><div class="field-desc">用说话的方式提醒你休息</div></div>
        <label class="switch"><input type="checkbox" id="swSpeech" checked><span class="switch-track"></span><span class="switch-thumb"></span></label>
      </div>
      <div class="field-row">
        <div><div class="field-label">听一下提醒声</div><div class="field-desc">按中度疲劳的强度播放一次</div></div>
        <button class="btn btn-secondary btn-sm" id="btnTestAlarm" type="button">试听</button>
      </div>
    </div>

    <div class="field-group">
      <div class="group-title">画面</div>
      <div class="field-row">
        <div><div class="field-label">摄像头</div><div class="field-desc">换了之后需要重新测一次基准</div></div>
        <select class="select" id="selCamera"></select>
      </div>
      <div class="field-row">
        <div><div class="field-label">在脸上显示识别点</div></div>
        <label class="switch"><input type="checkbox" id="swMesh" checked><span class="switch-track"></span><span class="switch-thumb"></span></label>
      </div>
      <div class="field-row">
        <div><div class="field-label">画面左右翻转</div><div class="field-desc">像照镜子一样，动作更好对应</div></div>
        <label class="switch"><input type="checkbox" id="swMirror" checked><span class="switch-track"></span><span class="switch-thumb"></span></label>
      </div>
      <div class="field-row pro-only">
        <div><div class="field-label">推理委托</div><div class="field-desc">GPU 更快，CPU 兼容性更好</div></div>
        <div class="segmented" id="segDelegate" role="tablist">
          <button type="button" role="tab" data-v="GPU" aria-selected="true">GPU</button>
          <button type="button" role="tab" data-v="CPU" aria-selected="false">CPU</button>
        </div>
      </div>
    </div>

    <div class="field-group">
      <div class="group-title">演示</div>
      <div class="field-row">
        <div><div class="field-label">演示模式</div><div class="field-desc">不用摄像头，用一段模拟的疲劳过程走通完整流程</div></div>
        <label class="switch"><input type="checkbox" id="swSimulate"><span class="switch-track"></span><span class="switch-thumb"></span></label>
      </div>
    </div>
  </div>
  <div class="sheet-foot">
    <button class="btn btn-ghost" id="btnResetCfg" type="button">恢复默认</button>
    <button class="btn btn-primary" id="btnSaveCfg" type="button">保存</button>
  </div>
</aside>

<script type="module" src="js/app.js"></script>
</body>
</html>
