{
  "name": "driver-fatigue-detection-web",
  "version": "1.0.0",
  "private": true,
  "description": "基于面部多特征融合的 Web 端驾驶员疲劳检测系统（本科毕业设计）",
  "scripts": {
    "start": "node server/server.js",
    "serve": "node server/server.js --no-open",
    "vendor": "node tools/fetch-vendor.js",
    "check": "node --experimental-vm-modules tools/project-check.mjs",
    "test": "node tools/regression-test.mjs",
    "test:integration": "node tools/integration-test.mjs",
    "verify": "npm run check && npm run test",
    "verify:full": "node tools/full-verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "fatigue-detection",
    "PERCLOS",
    "mediapipe",
    "face-landmark",
    "multi-feature-fusion"
  ],
  "license": "MIT"
}
